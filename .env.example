# Copy to .env and fill in ONE of the keys (all have free tiers).
LLM_PROVIDER=                # groq | gemini | openrouter | offline (empty = auto-detect from the key)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides
# GROQ_MODEL=groq/llama-3.3-70b-versatile
# GEMINI_MODEL=gemini/gemini-2.0-flash
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
